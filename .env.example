# Copy this file to .env and fill in real values
NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string (from https://cloud.mongodb.com)
# Format: mongodb+srv://USER:PASS@cluster.xxxxx.mongodb.net/fitness?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/fitness?retryWrites=true&w=majority

# JWT signing secret - MUST be at least 32 random characters
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-long-random-string-at-least-32-characters
JWT_EXPIRES_IN=7d

# Optional: enable AI features by adding your Gemini API key
# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Frontend URL (used for CORS - only this origin can call the API)
FRONTEND_URL=http://localhost:5173

LOG_LEVEL=info
